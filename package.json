{
  "name": "openbrowser",
  "version": "1.1.0",
  "description": "Enhanced MCP Playwright Browser Server — smart navigation, persistent locator cache, auto-wait, force-click, and delta-only DOM updates",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openbrowser": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "eslint": "^9.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
